<Window x:Class="AudioConvert.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="音频格式转换"
        Width="1000"
        Height="620"
        MinWidth="1000"
        MinHeight="620"
        MaxWidth="1000"
        MaxHeight="620"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Icon="Assets/AppIcon.png"
        AllowsTransparency="True"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F3F7FA" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F8FBFD" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#14B8A6" />
        <SolidColorBrush x:Key="TitleBrush" Color="#172033" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#657083" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#DDE7F0" />

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="20"
                          Direction="270"
                          Opacity="0.11"
                          ShadowDepth="6"
                          Color="#233044" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#F3F7FA" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>

        <Style x:Key="HeaderSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#F3F7FA" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#EEF6FF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#BFDBFE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderQuotaButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderSecondaryButtonStyle}">
            <Setter Property="Background" Value="#FFF7E6" />
            <Setter Property="BorderBrush" Value="#F6C56A" />
            <Setter Property="Foreground" Value="#8A4B00" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FEF3C7" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#F59E0B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#EEF6FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#DBEAFE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="TimeTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TextBoxStyle}">
            <Setter Property="Width" Value="48" />
            <Setter Property="Padding" Value="6,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="#9CA3AF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TitleBrush}" />
            <Setter Property="MaxDropDownHeight" Value="180" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <Grid>
                                                <Path Width="10"
                                                      Height="6"
                                                      Margin="0,0,12,0"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Data="M1,1 L5,5 L9,1"
                                                      Stroke="#4B5563"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round"
                                                      StrokeThickness="1.6" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#6B7280" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="12,0,34,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              IsHitTestVisible="False" />
                            <Popup x:Name="Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   PopupAnimation="Fade">
                                <Grid MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Margin="0,4,0,0"
                                            Background="White"
                                            BorderBrush="#9CA3AF"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <ScrollViewer Margin="4"
                                                      SnapsToDevicePixels="True">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="{StaticResource TitleBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemRoot"
                                Margin="2"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="#EEF6FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="#DBEAFE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FeatureCardStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                MinHeight="132"
                                Padding="16"
                                Background="White"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Effect="{StaticResource CardShadow}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#EEF6FF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#93C5FD" />
                                <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border 
        Padding="20"
        Background="{StaticResource CardBackgroundBrush}"
        BorderBrush="{StaticResource BorderBrushSoft}"
        BorderThickness="1"
        CornerRadius="22"
        Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            MouseLeftButtonDown="TitleArea_MouseLeftButtonDown">
                    <Border Width="42"
                Height="42"
                Background="#E8F4FF"
                CornerRadius="12">
                        <Image Width="28"
                   Height="28"
                   Source="Assets/AppIcon.png" />
                    </Border>
                    <StackPanel Margin="14,0,0,0">
                        <TextBlock FontSize="25"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TitleBrush}"
                       Text="全平台音频格式转换器" />
                        <TextBlock Margin="0,3,0,0"
                       FontSize="13"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="一站式音频处理工具" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                    <Button Width="74"
                            Command="{Binding LoginCommand}"
                            Content="登录"
                            Style="{StaticResource HeaderSecondaryButtonStyle}" />
                    <Button Width="98"
                            Margin="8,0,0,0"
                            Command="{Binding PurchaseQuotaCommand}"
                            Content="购买额度"
                            Style="{StaticResource HeaderQuotaButtonStyle}" />
                    <Button Margin="12,0,0,0"
                            Click="MinimizeButton_Click"
                            Style="{StaticResource WindowIconButtonStyle}">
                        <Image Width="16"
                               Height="16"
                               Source="Assets/缩小窗口.png"
                               Stretch="Uniform" />
                    </Button>
                    <Button Margin="6,0,0,0"
                            Click="CloseButton_Click"
                            Style="{StaticResource WindowIconButtonStyle}">
                        <Image Width="16"
                               Height="16"
                               Source="Assets/关闭窗口.png"
                               Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1"
      Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="500" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <UniformGrid Columns="2">
                    <RadioButton Command="{Binding SelectToolCommand}"
                     CommandParameter="Convert"
                     IsChecked="{Binding IsConvertTool, Mode=OneWay, FallbackValue=True}"
                     Style="{StaticResource FeatureCardStyle}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48"
                        Height="48"
                        VerticalAlignment="Center"
                        Background="#F1F5F9"
                        CornerRadius="24">
                                <Path Width="27"
                          Height="27"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M7,7 L17,7 M17,7 L14,4 M17,7 L14,10 M17,17 L7,17 M7,17 L10,14 M7,17 L10,20 M5,12 A7,7 0 0,1 12,5 M19,12 A7,7 0 0,1 12,19"
                          Fill="Transparent"
                          Stroke="#64748B"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeThickness="2.2"
                          Stretch="Uniform" />
                            </Border>
                            <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                                <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TitleBrush}"
                               Text="音频格式转换"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                                <TextBlock Margin="0,7,0,0"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="支持MGG / MFLAC / KGG / KGMA / KWM/ MP3 / FLAC / WAV / OGG / NCM"
                               TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </RadioButton>

                    <RadioButton Command="{Binding SelectToolCommand}"
                     CommandParameter="Trim"
                     IsChecked="{Binding IsTrimTool, Mode=OneWay, FallbackValue=False}"
                     Style="{StaticResource FeatureCardStyle}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48"
                        Height="48"
                        VerticalAlignment="Center"
                        Background="#F1F5F9"
                        CornerRadius="24">
                                <Path Width="27"
                          Height="27"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M5,5 L19,19 M19,5 L5,19 M4,18 A2,2 0 1,0 8,18 A2,2 0 1,0 4,18 M16,18 A2,2 0 1,0 20,18 A2,2 0 1,0 16,18 M9,12 L15,12"
                          Fill="Transparent"
                          Stroke="#64748B"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeThickness="2.2"
                          Stretch="Uniform" />
                            </Border>
                            <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                                <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TitleBrush}"
                               Text="音频切割"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                                <TextBlock Margin="0,7,0,0"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="按起止时间裁剪片段"
                               TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </RadioButton>

                    <RadioButton Command="{Binding SelectToolCommand}"
                     CommandParameter="Merge"
                     IsChecked="{Binding IsMergeTool, Mode=OneWay, FallbackValue=False}"
                     Style="{StaticResource FeatureCardStyle}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48"
                        Height="48"
                        VerticalAlignment="Center"
                        Background="#F1F5F9"
                        CornerRadius="24">
                                <Path Width="27"
                          Height="27"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M4,7 L10,7 C13,7 13,12 16,12 L21,12 M4,17 L10,17 C13,17 13,12 16,12 M18,9 L21,12 L18,15"
                          Fill="Transparent"
                          Stroke="#64748B"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeThickness="2.2"
                          Stretch="Uniform" />
                            </Border>
                            <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                                <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TitleBrush}"
                               Text="音频合并"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                                <TextBlock Margin="0,7,0,0"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="按列表顺序合并多个文件"
                               TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </RadioButton>

                    <RadioButton Command="{Binding SelectToolCommand}"
                     CommandParameter="Compress"
                     IsChecked="{Binding IsCompressTool, Mode=OneWay, FallbackValue=False}"
                     Style="{StaticResource FeatureCardStyle}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48"
                        Height="48"
                        VerticalAlignment="Center"
                        Background="#F1F5F9"
                        CornerRadius="24">
                                <Path Width="27"
                          Height="27"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M5,7 L5,17 M10,4 L10,20 M15,8 L15,16 M20,10 L20,14 M7,12 L17,12 M14,9 L17,12 L14,15"
                          Fill="Transparent"
                          Stroke="#64748B"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeThickness="2.2"
                          Stretch="Uniform" />
                            </Border>
                            <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                                <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TitleBrush}"
                               Text="音频压缩"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                                <TextBlock Margin="0,7,0,0"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="三档质量压缩为 MP3"
                               TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </RadioButton>
                </UniformGrid>

                <Border Grid.Column="1"
            Margin="16,0,0,14"
            Padding="22"
            Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TitleBrush}"
                           Text="{Binding CurrentToolTitle, FallbackValue=音频格式转换, TargetNullValue=音频格式转换}" />
                            <TextBlock Margin="0,6,0,0"
                           FontSize="13"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding CurrentToolDescription, FallbackValue=支持多种音频格式处理, TargetNullValue=支持多种音频格式处理}" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1"
                          Margin="0,18,0,12"
                          VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConvertTool}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button Width="140"
                            HorizontalAlignment="Left"
                            Command="{Binding SelectSingleFileCommand}"
                            Content="选择音频文件"
                            Style="{StaticResource PrimaryButtonStyle}" />
                                    <TextBlock Margin="0,10,0,16"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding SelectedFileDisplayText, FallbackValue=尚未选择音频文件, TargetNullValue=尚未选择音频文件}"
                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="输出格式" />
                                    <ComboBox Width="160"
                              Margin="0,6,0,0"
                              HorizontalAlignment="Left"
                              DisplayMemberPath="DisplayName"
                              ItemsSource="{Binding OutputFormats}"
                              SelectedItem="{Binding SelectedOutputFormat}"
                              Style="{StaticResource ComboBoxStyle}" />
                                </StackPanel>

                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTrimTool}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button Width="140"
                            HorizontalAlignment="Left"
                            Command="{Binding SelectSingleFileCommand}"
                            Content="选择音频文件"
                            Style="{StaticResource PrimaryButtonStyle}" />
                                    <TextBlock Margin="0,10,0,14"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding SelectedFileDisplayText}"
                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="开始时间" />
                                    <StackPanel Margin="0,6,0,12"
                                Orientation="Horizontal">
                                        <TextBox Style="{StaticResource TimeTextBoxStyle}"
                                 Text="{Binding TrimStartHours, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Margin="6,0,12,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="时" />
                                        <TextBox Style="{StaticResource TimeTextBoxStyle}"
                                 Text="{Binding TrimStartMinutes, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Margin="6,0,12,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="分" />
                                        <TextBox Style="{StaticResource TimeTextBoxStyle}"
                                 Text="{Binding TrimStartSeconds, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="秒" />
                                    </StackPanel>

                                    <TextBlock FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="结束时间" />
                                    <StackPanel Margin="0,6,0,0"
                                Orientation="Horizontal">
                                        <TextBox Style="{StaticResource TimeTextBoxStyle}"
                                 Text="{Binding TrimEndHours, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Margin="6,0,12,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="时" />
                                        <TextBox Style="{StaticResource TimeTextBoxStyle}"
                                 Text="{Binding TrimEndMinutes, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Margin="6,0,12,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="分" />
                                        <TextBox Style="{StaticResource TimeTextBoxStyle}"
                                 Text="{Binding TrimEndSeconds, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="秒" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMergeTool}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button Width="140"
                            HorizontalAlignment="Left"
                            Command="{Binding SelectMergeFilesCommand}"
                            Content="添加音频文件"
                            Style="{StaticResource PrimaryButtonStyle}" />
                                    <TextBlock Margin="0,8,0,8"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding MergeFileCountText}" />
                                    <ListBox Height="116"
                             BorderBrush="{StaticResource BorderBrushSoft}"
                             ItemsSource="{Binding MergeFiles}"
                             SelectedItem="{Binding SelectedMergeFile}"
                             FontSize="12" />
                                    <StackPanel Margin="0,8,0,0"
                                Orientation="Horizontal">
                                        <Button Width="58"
                                Command="{Binding MoveMergeFileUpCommand}"
                                Content="上移"
                                Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Width="58"
                                Margin="8,0,0,0"
                                Command="{Binding MoveMergeFileDownCommand}"
                                Content="下移"
                                Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Width="58"
                                Margin="8,0,0,0"
                                Command="{Binding RemoveMergeFileCommand}"
                                Content="移除"
                                Style="{StaticResource SecondaryButtonStyle}" />
                                        <ComboBox Width="104"
                                  Margin="12,0,0,0"
                                  DisplayMemberPath="DisplayName"
                                  ItemsSource="{Binding OutputFormats}"
                                  SelectedItem="{Binding SelectedMergeOutputFormat}"
                                  Style="{StaticResource ComboBoxStyle}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompressTool}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button Width="140"
                            HorizontalAlignment="Left"
                            Command="{Binding SelectSingleFileCommand}"
                            Content="选择音频文件"
                            Style="{StaticResource PrimaryButtonStyle}" />
                                    <TextBlock Margin="0,10,0,16"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding SelectedFileDisplayText}"
                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="压缩质量" />
                                    <ComboBox Width="180"
                              Margin="0,6,0,0"
                              HorizontalAlignment="Left"
                              DisplayMemberPath="DisplayName"
                              ItemsSource="{Binding CompressionQualities}"
                              SelectedItem="{Binding SelectedCompressionQuality}"
                              Style="{StaticResource ComboBoxStyle}" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{Binding QuotaStatusText, FallbackValue=剩余次数：正在读取..., TargetNullValue=剩余次数：正在读取...}"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1"
                                    Width="130"
                                    Margin="12,0,0,0"
                                    Command="{Binding ExecuteCommand}"
                                    Content="开始处理"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2"
        Height="30"
        Padding="16,0"
        Background="{StaticResource PanelBackgroundBrush}"
        BorderBrush="{StaticResource BorderBrushSoft}"
        BorderThickness="1"
        CornerRadius="10">
                <Grid>
                    <TextBlock VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="任务状态" />
                    <TextBlock HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="{StaticResource AccentBrush}"
                   Text="{Binding StatusText, FallbackValue=准备就绪, TargetNullValue=准备就绪}"
                   TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
