<Window x:Class="AudioConvert.PurchaseQuotaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="购买额度"
        Width="460"
        Height="380"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">
    <Window.Resources>
        <SolidColorBrush x:Key="TitleBrush" Color="#172033" />
        <SolidColorBrush x:Key="MutedBrush" Color="#657083" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="SoftBorderBrush" Color="#DDE7F0" />
        <DropShadowEffect x:Key="DialogShadow"
                          BlurRadius="22"
                          Direction="270"
                          Opacity="0.16"
                          ShadowDepth="8"
                          Color="#233044" />
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.74" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            Padding="30"
            Background="White"
            BorderBrush="{StaticResource SoftBorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Effect="{StaticResource DialogShadow}"
            MouseLeftButtonDown="Dialog_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock FontSize="23"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TitleBrush}"
                           Text="购买额度" />
                <TextBlock Margin="0,8,0,0"
                           FontSize="13"
                           Foreground="{StaticResource MutedBrush}"
                           Text="{Binding BalanceText}" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,22,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="#E8EEF5" />
                <Border Grid.Row="1"
                        Margin="0,18,0,0"
                        Padding="18"
                        Background="#F8FBFD"
                        BorderBrush="{StaticResource SoftBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TitleBrush}"
                                   Text="{Binding PackageTitle}" />
                        <TextBlock Grid.Column="1"
                                   Margin="16,0,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Text="{Binding PackagePrice}" />
                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Margin="0,10,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="{Binding PackageDescription}"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2"
                                   Grid.ColumnSpan="2"
                                   Margin="0,12,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="{Binding PackageMeta}" />
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Width="128"
                        Margin="0,0,12,0"
                        Background="{StaticResource PrimaryBrush}"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="1"
                        Click="BuyButton_Click"
                        Foreground="White"
                        IsEnabled="{Binding CanBuy}"
                        Style="{StaticResource DialogButtonStyle}"
                        Content="立即购买" />
                <Button Width="86"
                        Background="#F3F7FA"
                        BorderBrush="{StaticResource SoftBorderBrush}"
                        BorderThickness="1"
                        Click="CloseButton_Click"
                        Foreground="{StaticResource MutedBrush}"
                        Style="{StaticResource DialogButtonStyle}"
                        Content="关闭" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
