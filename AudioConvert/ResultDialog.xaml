<Window x:Class="AudioConvert.ResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="处理结果"
        Width="420"
        Height="340"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">
    <Window.Resources>
        <SolidColorBrush x:Key="TitleBrush" Color="#172033" />
        <SolidColorBrush x:Key="MutedBrush" Color="#657083" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="SoftBorderBrush" Color="#DDE7F0" />
        <DropShadowEffect x:Key="DialogShadow"
                          BlurRadius="22"
                          Direction="270"
                          Opacity="0.16"
                          ShadowDepth="8"
                          Color="#233044" />
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.74" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            Padding="30"
            Background="White"
            BorderBrush="{StaticResource SoftBorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Effect="{StaticResource DialogShadow}"
            MouseLeftButtonDown="Dialog_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="56"
                        Height="56"
                        HorizontalAlignment="Left"
                        Background="{Binding IconBackground}"
                        CornerRadius="28">
                    <Path Width="28"
                          Height="28"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="{Binding IconData}"
                          Fill="{Binding AccentBrush}"
                          Stretch="Uniform" />
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="10,2,0,0">
                    <TextBlock FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TitleBrush}"
                               Text="{Binding ResultTitle}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,22,0,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="#E8EEF5" />
                <ScrollViewer Grid.Row="1"
                              Margin="0,14,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               LineHeight="20"
                               Text="{Binding ResultMessage}"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>

            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button x:Name="PrimaryButton"
                        Width="128"
                        Margin="0,0,12,0"
                        Background="{StaticResource PrimaryBrush}"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="1"
                        Click="PrimaryButton_Click"
                        Foreground="White"
                        Style="{StaticResource DialogButtonStyle}"
                        Content="{Binding PrimaryButtonText}" />
                <Button Width="86"
                        Background="#F3F7FA"
                        BorderBrush="{StaticResource SoftBorderBrush}"
                        BorderThickness="1"
                        Click="CloseButton_Click"
                        Foreground="{StaticResource MutedBrush}"
                        Style="{StaticResource DialogButtonStyle}"
                        Content="关闭" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
