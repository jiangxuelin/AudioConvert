<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net472</TargetFramework>
	  <LangVersion>latest</LangVersion>
	  <PlatformTarget>AnyCPU</PlatformTarget>
	  <Nullable>enable</Nullable>
	  <Configurations>Debug;Release;微软;微软测试;微软联调</Configurations>
	  <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

	<PropertyGroup>
		<EasyHookManagedPath Condition="'$(Configuration)' == '微软' Or '$(Configuration)' == '微软测试' Or '$(Configuration)' == '微软联调'">..\ThirdParty\EasyHook\lib\net40-msix\EasyHook.dll</EasyHookManagedPath>
		<EasyHookManagedPath Condition="'$(EasyHookManagedPath)' == ''">..\ThirdParty\EasyHook\lib\net40\EasyHook.dll</EasyHookManagedPath>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="EasyHook">
			<HintPath>$(EasyHookManagedPath)</HintPath>
			<Private>true</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<None Include="..\ThirdParty\EasyHook\content\net40\EasyHook32.dll" Link="EasyHook32.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="..\ThirdParty\EasyHook\content\net40\EasyHook32Svc.exe" Link="EasyHook32Svc.exe">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="..\ThirdParty\EasyHook\content\net40\EasyHook64.dll" Link="EasyHook64.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="..\ThirdParty\EasyHook\content\net40\EasyHook64Svc.exe" Link="EasyHook64Svc.exe">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="..\ThirdParty\EasyHook\content\net40\EasyLoad32.dll" Link="EasyLoad32.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="..\ThirdParty\EasyHook\content\net40\EasyLoad64.dll" Link="EasyLoad64.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
